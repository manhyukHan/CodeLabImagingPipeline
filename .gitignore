data/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Rendered inspection output from tools/fit_testbox.py -- regenerable
# from the store, and a full harvest is hundreds of MB of PNG.
notes/chromatin_tracing_optimization/

# The log folder itself is tracked (via .gitkeep) so a fresh checkout has
# it; everything written INTO it -- launcher logs, saved session logs -- is
# not. Order matters: the un-ignore must follow the ignore.
log/*
!log/.gitkeep

# Launcher logs from before they moved into log/, plus any that land beside
# the app when the project folder is read-only and the launcher falls back.
codelab_launch_*.log

# The launcher's remembered interpreter path (launch_codelab.bat). Names a
# location on THIS machine, so it must never be shared -- every checkout
# resolves its own on first launch.
.codelab_python

# Shortcuts made by make_shortcut.vbs. A .lnk stores ABSOLUTE paths, so a
# committed one is broken for everyone but its author -- run the script
# once per checkout instead.
*.lnk

# Documentation is kept locally, not versioned (per explicit decision
# 2026-09-06). The Sphinx tree, the analysis notes and the manuscript
# source material all live here and all stay on disk -- `git rm -r --cached
# docs` removed them from tracking, it did not delete them. Anything in
# here that a reader of the repository needs must therefore be stated in
# code comments, in README.md, or in a commit message instead.
docs/

# Per-user launcher state: whose bundle and whose name, not the repo's.
spotcheck/last_session.json
# Build model window: last bundle path, per machine
spotcheck/build_model_last.json
